    <string name="open_launcher_selection">Escolher launcher</string>
    <string name="exit_launcher_settings_message">Este aparelho esta usando o HX KIOSK como launcher padrao. Escolha outro launcher para sair para a tela inicial normal.</string>
    <string name="accessibility_service_description">Mantem o hxkiosk em primeiro plano, fecha a barra de notificacoes e impede atalhos do sistema sem precisar formatar o tablet.</string>
    <string name="accessibility_title">Ativar acessibilidade</string>
    <string name="accessibility_message">Ative o servico hxkiosk em Acessibilidade. Isso permite bloquear notificacoes, recentes e saida do quiosque sem Device Owner e sem formatar o tablet.</string>
    <string name="notification_listener_title">Acesso as notificacoes</string>
    <string name="notification_listener_message">Permita que o hxkiosk leia e cancele notificacoes para esconder alertas enquanto o quiosque estiver ativo.</string>
    <string name="release_device_access">Liberar acesso do tablet</string>
    <string name="release_device_access_message">Remove Device Owner e o administrador do dispositivo sem formatar. Depois escolha outro launcher para usar o tablet normalmente.</string>
    <string name="release_device_access_success">Acesso corporativo liberado. Escolha outro launcher se ainda estiver no hxkiosk.</string>
    <string name="release_device_access_partial">O modo quiosque foi pausado. Se o Device Owner continuar ativo, use este mesmo botao de novo ou o console remoto.</string>
