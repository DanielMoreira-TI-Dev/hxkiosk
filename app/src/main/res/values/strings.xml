    <string name="launcher_role_title">Definir launcher padrao</string>
    <string name="launcher_role_message">Escolha o HX KIOSK como launcher padrao para que o dispositivo volte sempre para este app ao pressionar Home ou reiniciar.</string>
    <string name="device_admin_title">Ativar administracao do dispositivo</string>
    <string name="device_admin_message">O Android vai abrir a tela de permissao de administrador do dispositivo para habilitar os controles de quiosque.</string>
